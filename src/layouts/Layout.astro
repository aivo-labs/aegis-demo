---
import '../styles/global.css';
import AegisLogo from '../components/AegisLogo.astro';
import { useTranslations, type Locale } from '../i18n/translations';

interface Props {
	title?: string;
	description?: string;
	isApp?: boolean;
	lang?: Locale;
}

const pathname = Astro.url.pathname;
const detectedLang: Locale = pathname.startsWith('/fr/') || pathname === '/fr' ? 'fr' : 'en';

const { 
  lang = detectedLang,
  title = lang === 'fr' 
    ? "Aegis • Cybersécurité Souveraine & Sobriété Numérique"
    : "Aegis • Sovereign Cybersecurity & Hardware Frugality", 
  description = lang === 'fr'
    ? "Passerelle Ingress Zero-Trust (< 1.5 ms), blocage d'exfiltration DNS par IA locale Nimble 9B Air-Gapped, et télémétrie matérielle brute (Watts/Joules RAPL & Kepler)."
    : "Ingress Zero-Trust Gateway (< 1.5 ms), DNS exfiltration prevention powered by local Nimble 9B Air-Gapped SLM, and raw hardware telemetry (Watts/Joules RAPL & Kepler).",
  isApp = false
} = Astro.props;

const t = useTranslations(lang).nav;

// Calcul dynamique des URLs alternatives EN / FR pour le sélecteur de langue
let enUrl = '/';
let frUrl = '/fr/';

if (pathname.startsWith('/docs')) {
  if (pathname.startsWith('/docs/fr/') || pathname === '/docs/fr') {
    frUrl = pathname;
    enUrl = pathname.replace('/docs/fr', '/docs');
  } else {
    enUrl = pathname;
    frUrl = pathname.replace('/docs', '/docs/fr');
  }
} else if (lang === 'fr') {
  frUrl = pathname;
  enUrl = pathname.replace(/^\/fr(\/|$)/, '/');
  if (!enUrl.startsWith('/')) enUrl = '/' + enUrl;
} else {
  enUrl = pathname;
  frUrl = pathname === '/' ? '/fr/' : `/fr${pathname.endsWith('/') ? pathname : pathname + '/'}`;
}
---

<!DOCTYPE html>
<html lang={lang} class:list={["scroll-smooth bg-[#0a0f1d] text-slate-100", isApp && "h-screen overflow-hidden"]}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<script is:inline>
			(function() {
				try {
					const theme = localStorage.getItem('aegis_theme');
					if (theme === 'light') {
						document.documentElement.classList.add('theme-light');
					} else {
						document.documentElement.classList.remove('theme-light');
					}
				} catch(e) {}
			})();
		</script>
	</head>
	<body class:list={[
		"bg-[#0a0f1d] antialiased selection:bg-emerald-400 selection:text-slate-950",
		isApp ? "h-screen max-h-screen overflow-hidden flex flex-col" : "min-h-screen flex flex-col"
	]}>
		
		<!-- HEADER PUBLIC -->
		{!isApp && (
		<header class="sticky top-0 z-50 bg-[#0a0f1d]/90 backdrop-blur-md border-b border-slate-800/80 transition-all">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between gap-4">
				
				<!-- 1. GAUCHE : Logo Officiel + Nom + "CYBERSÉCURITÉ SOUVERAINE" -->
				<a href={lang === 'fr' ? "/fr/" : "/"} class="flex items-center gap-3 group shrink-0">
					<AegisLogo size="md" class="group-hover:scale-105 transition-transform" />
					<div class="flex flex-col">
						<span class="text-xl font-extrabold tracking-tight text-white leading-tight">
							Aegis
						</span>
						<span class="text-[10px] text-emerald-400/90 font-mono tracking-wider uppercase font-semibold">
							{t.tagline}
						</span>
					</div>
				</a>

				<!-- 2. CENTRE : Navigation Démo (Vue d'ensemble, Fuzzer, Triage SOC) + Documentation -->
				<nav class="hidden md:flex items-center gap-6 text-sm font-medium text-slate-300">
					<!-- Lien Vue d'ensemble (Dashboard Replay) -->
					<a href={lang === 'fr' ? "/fr/demo" : "/demo"} class="hover:text-cyan-300 transition-colors flex items-center gap-1.5 font-semibold text-xs font-mono">
						<span>📊</span>
						<span>{lang === 'fr' ? "Vue d'ensemble" : "Overview"}</span>
					</a>

					<!-- Lien Fuzzer et entropie -->
					<a href={lang === 'fr' ? "/fr/demo?tab=fuzzer" : "/demo?tab=fuzzer"} class="hover:text-emerald-300 transition-colors flex items-center gap-1.5 font-semibold text-xs font-mono">
						<span>🔬</span>
						<span>{lang === 'fr' ? "Fuzzer & Entropie" : "Fuzzer"}</span>
					</a>

					<!-- Lien Triage SOC -->
					<a href={lang === 'fr' ? "/fr/demo?tab=triage" : "/demo?tab=triage"} class="hover:text-amber-300 transition-colors flex items-center gap-1.5 font-semibold text-xs font-mono">
						<span>📋</span>
						<span>{lang === 'fr' ? "Triage SOC" : "SOC Triage"}</span>
					</a>

					<!-- Lien Externe Documentation -->
					<a href="https://aegis.aivo.fr/docs/" target="_blank" rel="noopener noreferrer" class="hover:text-slate-100 transition-colors flex items-center gap-1 text-xs font-mono text-slate-400">
						<span>Documentation</span>
						<span class="text-[10px]">↗</span>
					</a>
				</nav>

				<!-- 3. DROITE : GitHub + Toggle Thème + Dropdown Sélecteur de Langue + Bouton Login -->
				<div class="flex items-center gap-2 sm:gap-2.5">
					<!-- Logo GitHub menant au dépôt -->
					<a 
						href="https://github.com/aivo-labs/aegis" 
						target="_blank" 
						rel="noopener noreferrer" 
						class="w-9 h-9 rounded-xl bg-slate-900/90 hover:bg-slate-800 border border-slate-800 hover:border-slate-700 flex items-center justify-center text-slate-300 hover:text-white transition-all"
						title="Source code on GitHub (AGPLv3)"
					>
						<svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
							<path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
						</svg>
					</a>

					<!-- Sélecteur de Langue Dropdown avec Drapeaux (🇬🇧 / 🇫🇷) -->
					<div class="relative group/lang">
						<button 
							type="button" 
							class="h-9 px-2.5 rounded-xl bg-slate-900/90 hover:bg-slate-800 border border-slate-800 hover:border-slate-700 flex items-center gap-1.5 text-xs font-mono text-slate-200 transition-colors cursor-pointer"
							aria-label={lang === 'fr' ? 'Changer de langue' : 'Switch language'}
						>
							<span class="text-sm leading-none">{lang === 'fr' ? '🇫🇷' : '🇬🇧'}</span>
							<span class="font-bold">{lang === 'fr' ? 'FR' : 'EN'}</span>
							<svg class="w-3.5 h-3.5 text-slate-400 group-hover/lang:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
							</svg>
						</button>

						<!-- Menu déroulant des langues -->
						<div class="absolute right-0 top-full pt-2 w-36 opacity-0 invisible group-hover/lang:opacity-100 group-hover/lang:visible transition-all duration-200 z-50">
							<div class="bg-slate-900/95 backdrop-blur-xl border border-slate-800 rounded-2xl p-1.5 shadow-2xl space-y-1 font-mono text-xs">
								<a 
									href={enUrl} 
									class:list={[
										"flex items-center justify-between px-3 py-2 rounded-xl transition-colors",
										lang === 'en' ? "bg-emerald-500/15 text-emerald-300 font-bold border border-emerald-500/30" : "text-slate-300 hover:bg-slate-800 hover:text-white"
									]}
								>
									<span class="flex items-center gap-2">
										<span class="text-base leading-none">🇬🇧</span>
										<span>English</span>
									</span>
									{lang === 'en' && <span class="text-emerald-400 text-xs">✓</span>}
								</a>

								<a 
									href={frUrl} 
									class:list={[
										"flex items-center justify-between px-3 py-2 rounded-xl transition-colors",
										lang === 'fr' ? "bg-emerald-500/15 text-emerald-300 font-bold border border-emerald-500/30" : "text-slate-300 hover:bg-slate-800 hover:text-white"
									]}
								>
									<span class="flex items-center gap-2">
										<span class="text-base leading-none">🇫🇷</span>
										<span>Français</span>
									</span>
									{lang === 'fr' && <span class="text-emerald-400 text-xs">✓</span>}
								</a>
							</div>
						</div>
					</div>

					<!-- Groupe Toggle Thème Clair/Sombre + Point d'interrogation (?) avec Tooltip -->
					<div class="relative flex items-center bg-slate-900/90 border border-slate-800 rounded-xl p-0.5">
						<button
							type="button"
							id="theme-toggle-btn"
							onclick="toggleAegisTheme()"
							class="w-8 h-8 rounded-lg text-sm text-slate-300 hover:text-emerald-400 flex items-center justify-center transition-colors cursor-pointer"
							title={lang === 'fr' ? "Basculer entre thème sombre et clair" : "Switch between dark and light theme"}
							aria-label="Toggle theme"
						>
							<span id="theme-toggle-icon">🌙</span>
						</button>

						<!-- Tooltip d'écoconception -->
						<div class="relative group/tooltip">
							<button
								type="button"
								class="w-5 h-5 rounded-md bg-slate-800/80 hover:bg-emerald-500/20 text-slate-400 hover:text-emerald-300 font-mono text-[10px] font-bold flex items-center justify-center transition-colors cursor-help mr-0.5"
								aria-label="RGESN info"
							>
								?
							</button>

							<div class="absolute right-0 top-full mt-2.5 w-72 p-3.5 rounded-2xl bg-slate-900/95 backdrop-blur-xl border border-emerald-500/40 shadow-2xl text-left opacity-0 invisible group-hover/tooltip:opacity-100 group-hover/tooltip:visible transition-all duration-200 z-50 pointer-events-none">
								<div class="flex items-center gap-2 text-xs font-bold text-emerald-300 font-mono mb-1">
									<span>🍃</span>
									<span>{t.rgesnTooltipTitle}</span>
								</div>
								<p class="text-[11px] text-slate-300 leading-relaxed font-sans">
									{t.rgesnTooltipText}
								</p>
							</div>
						</div>
					</div>

					<!-- Bouton CTA vers la solution réelle -->
					<a 
						href="https://aegis.aivo.fr/get-started/" 
						target="_blank"
						rel="noopener noreferrer"
						class="px-4 py-2 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-400 hover:from-emerald-400 hover:to-teal-300 text-slate-950 font-extrabold text-xs font-mono shadow-lg shadow-emerald-500/20 hover:shadow-emerald-500/35 transition-all active:scale-95 flex items-center gap-1.5"
					>
						<span>{lang === 'fr' ? 'Accéder à Aegis' : 'Get Started'}</span>
						<span class="text-xs">↗</span>
					</a>
				</div>

			</div>
		</header>
		)}

		<!-- MAIN CONTENT -->
		<div class:list={["flex flex-col", isApp ? "flex-1 min-h-0 h-full overflow-hidden" : "flex-grow"]}>
			<slot />
		</div>

		<!-- FOOTER -->
		{!isApp && (
		<footer class="bg-slate-950 border-t border-slate-800/80 py-10 px-4 text-slate-400 text-xs">
			<div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6">
				<div class="flex items-center gap-3">
					<AegisLogo size="sm" />
					<span class="font-bold text-white text-sm">Aegis</span>
					<span class="text-slate-500 font-mono">• {lang === 'fr' ? "Démonstrateur Interactif & Sandbox Replay (AGPLv3)" : "Interactive Showcase & Sandbox Replay (AGPLv3)"}</span>
				</div>
				<div class="flex flex-wrap items-center gap-6 font-mono text-[11px]">
					<a href={lang === 'fr' ? "/fr/demo" : "/demo"} class="hover:text-cyan-400">{lang === 'fr' ? "Vue d'ensemble" : "Overview"}</a>
					<a href={lang === 'fr' ? "/fr/demo?tab=fuzzer" : "/demo?tab=fuzzer"} class="hover:text-emerald-400">{lang === 'fr' ? "Fuzzer" : "Fuzzer"}</a>
					<a href={lang === 'fr' ? "/fr/demo?tab=triage" : "/demo?tab=triage"} class="hover:text-amber-400">{lang === 'fr' ? "Triage SOC" : "SOC Triage"}</a>
					<a href="https://aegis.aivo.fr/docs/" target="_blank" rel="noopener noreferrer" class="hover:text-slate-200">Documentation ↗</a>
					<a href="https://aegis.aivo.fr" target="_blank" rel="noopener noreferrer" class="hover:text-slate-200">{lang === 'fr' ? "Site Officiel" : "Official Site"} ↗</a>
					<a href="https://github.com/aivo-labs/aegis" target="_blank" rel="noopener noreferrer" class="hover:text-slate-200">GitHub ↗</a>
				</div>
			</div>
		</footer>
		)}

		<script is:inline>
			function updateThemeUI() {
				const isLight = document.documentElement.classList.contains('theme-light');
				const icon = document.getElementById('theme-toggle-icon');
				if (icon) icon.innerText = isLight ? '☀️' : '🌙';
			}

			function toggleAegisTheme() {
				const isLight = document.documentElement.classList.toggle('theme-light');
				try {
					localStorage.setItem('aegis_theme', isLight ? 'light' : 'dark');
				} catch (e) {}
				updateThemeUI();
				window.dispatchEvent(new CustomEvent('aegis-theme-changed', { detail: { isLight } }));
			}

			document.addEventListener('DOMContentLoaded', updateThemeUI);
			window.addEventListener('aegis-theme-changed', (e) => {
				updateThemeUI();
			});
		</script>

	</body>
</html>
