---
import Layout from '../layouts/Layout.astro';
import AegisLogo from '../components/AegisLogo.astro';
---

<Layout 
  title="Aegis Community Edition • Sovereign Cybersecurity & Hardware Frugality"
  description="Open-source sovereign cybersecurity suite: Ingress Zero-Trust WAF (< 1.5 ms), local AI-driven DNS exfiltration block (Nimble 9B), and raw hardware telemetry (RAPL Watts/Joules) under AGPLv3."
  lang="en"
>
  <main class="flex-grow flex flex-col font-sans text-slate-100">

    <!-- HERO SECTION -->
    <section class="relative pt-12 pb-20 sm:pt-20 sm:pb-28 overflow-hidden">
      <!-- Glow halos -->
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-6xl h-96 bg-gradient-to-b from-emerald-500/15 via-cyan-500/5 to-transparent blur-3xl pointer-events-none"></div>

      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
        
        <!-- Open Source Badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 font-mono text-xs font-semibold mb-6">
          <span>🛡️</span>
          <span>AEGIS COMMUNITY EDITION • OPEN SOURCE AGPLv3</span>
        </div>

        <!-- Main Title -->
        <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-white max-w-4xl mx-auto leading-tight mb-6">
          Sovereign Cybersecurity &amp; <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-teal-300">Hardware Frugality</span>
        </h1>

        <!-- Description -->
        <p class="text-base sm:text-xl text-slate-300 max-w-3xl mx-auto leading-relaxed mb-10">
          Lightweight open-source web security suite designed for on-premise deployments, sovereign servers, and critical infrastructures. 
          Ultra-fast Zero-Trust HTTP inspection (<span class="text-emerald-400 font-mono font-bold">&lt; 1.5 ms</span>), local AI-driven DNS exfiltration prevention, and direct hardware telemetry in Joules.
        </p>

        <!-- Main Action Buttons -->
        <div class="flex flex-col sm:flex-row flex-wrap items-center justify-center gap-4 max-w-2xl mx-auto font-mono text-xs font-bold mb-14">
          <a 
            href="/demo" 
            class="w-full sm:w-auto px-6 py-3.5 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-400 hover:from-emerald-400 hover:to-teal-300 text-slate-950 shadow-lg shadow-emerald-500/25 hover:shadow-emerald-500/40 transition-all flex items-center justify-center gap-2 cursor-pointer active:scale-95"
          >
            <span>⚡ Live Demo &amp; PHP2Shell Replay</span>
            <span>➔</span>
          </a>

          <a 
            href="/demo?tab=fuzzer" 
            class="w-full sm:w-auto px-6 py-3.5 rounded-xl bg-cyan-500/15 hover:bg-cyan-500/25 text-cyan-200 border border-cyan-500/40 transition-all flex items-center justify-center gap-2 cursor-pointer"
          >
            <span>🔬 Interactive Fuzzer</span>
          </a>

          <a 
            href="https://aegis.aivo.fr/docs/" 
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto px-6 py-3.5 rounded-xl bg-slate-900/90 hover:bg-slate-800 text-slate-200 hover:text-white border border-slate-700 hover:border-slate-600 transition-all flex items-center justify-center gap-2 cursor-pointer"
          >
            <span>📖 Documentation</span>
            <span class="text-xs">↗</span>
          </a>

          <a 
            href="https://github.com/aivo-labs/aegis" 
            target="_blank" 
            rel="noopener noreferrer"
            class="w-full sm:w-auto px-5 py-3.5 rounded-xl bg-slate-950/80 hover:bg-slate-900 text-slate-300 hover:text-emerald-300 border border-slate-800 flex items-center justify-center gap-2 transition-all"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
            <span>GitHub ⭐</span>
          </a>
        </div>

        <!-- Quickstart Terminal -->
        <div class="max-w-2xl mx-auto rounded-2xl bg-slate-950/90 border border-slate-800 p-4 text-left shadow-2xl relative font-mono text-xs">
          <div class="flex items-center justify-between pb-2 mb-2 border-b border-slate-900 text-slate-500 text-[11px]">
            <span class="flex items-center gap-1.5">
              <span class="w-2.5 h-2.5 rounded-full bg-rose-500/80 inline-block"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-amber-500/80 inline-block"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-500/80 inline-block"></span>
              <span class="ml-2 font-bold text-slate-400">Single Server &amp; Docker Quickstart</span>
            </span>
            <span>Frugal Profile (&lt; 200 MB RAM)</span>
          </div>
          <div class="text-emerald-300 font-semibold select-all break-all leading-relaxed">
            git clone https://github.com/aivo-labs/aegis.git &amp;&amp; cd aegis &amp;&amp; docker compose up -d
          </div>
        </div>

      </div>
    </section>

    <!-- 3 CORE PILLARS -->
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-20">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white mb-3">
          Modular &amp; Sovereign Architecture
        </h2>
        <p class="text-xs sm:text-sm text-slate-400 font-mono">
          Three independent engines running in complete synergy without bloating your host.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
        <!-- CARD 1: AEGIS GATE -->
        <div class="p-6 rounded-3xl bg-slate-900/60 border border-slate-800 hover:border-emerald-500/50 transition-all flex flex-col justify-between group">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-xl mb-4 group-hover:scale-105 transition-transform">
              🛡️
            </div>
            <h3 class="text-lg font-extrabold text-white mb-2">Aegis Gate (Ingress PEP)</h3>
            <p class="text-xs text-slate-300 leading-relaxed font-sans mb-4">
              Ultra-fast Zero-Trust Ingress gateway written in Go &amp; TypeScript. Unicode canonicalization, Shannon entropy analysis against obfuscated threats, and OWASP Top 10 mitigation in under 1.5ms.
            </p>
          </div>
          <div class="pt-4 border-t border-slate-800/80 font-mono text-[11px] text-emerald-400">
            • Pure BFF Token Handler (__Host- Cookies)
          </div>
        </div>

        <!-- CARD 2: AEGIS EGRESS -->
        <div class="p-6 rounded-3xl bg-slate-900/60 border border-slate-800 hover:border-cyan-500/50 transition-all flex flex-col justify-between group">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center text-xl mb-4 group-hover:scale-105 transition-transform">
              🌐
            </div>
            <h3 class="text-lg font-extrabold text-white mb-2">Aegis Egress (DNS &amp; AI Gateway)</h3>
            <p class="text-xs text-slate-300 leading-relaxed font-sans mb-4">
              Real-time DNS interception and telemetry. Semantic outbound analysis powered by local Nimble 9B Small Language Model (Air-Gapped) blocking C2 beaconing and covert exfiltration channels.
            </p>
          </div>
          <div class="pt-4 border-t border-slate-800/80 font-mono text-[11px] text-cyan-400">
            • Sovereign Local AI (Zero cloud leakage)
          </div>
        </div>

        <!-- CARD 3: AEGIS GREEN -->
        <div class="p-6 rounded-3xl bg-slate-900/60 border border-slate-800 hover:border-teal-500/50 transition-all flex flex-col justify-between group">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-teal-500/10 border border-teal-500/30 flex items-center justify-center text-xl mb-4 group-hover:scale-105 transition-transform">
              🌱
            </div>
            <h3 class="text-lg font-extrabold text-white mb-2">Aegis Green (Hardware Telemetry)</h3>
            <p class="text-xs text-slate-300 leading-relaxed font-sans mb-4">
              Ultra-frugal Rust agent reading directly from CPU Intel/AMD RAPL hardware registers via Scaphandre. Precise measurement of raw electrical consumption in Joules/Watts for audit-ready ESG reporting.
            </p>
          </div>
          <div class="pt-4 border-t border-slate-800/80 font-mono text-[11px] text-teal-400">
            • Physical RAPL measurement (Real Silicon)
          </div>
        </div>

      </div>
    </section>

    <!-- MANAGED CLOUD BANNER -->
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-20">
      <div class="p-6 sm:p-8 rounded-3xl bg-gradient-to-r from-slate-900 via-slate-950 to-slate-900 border border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-6">
        <div class="space-y-1 text-left">
          <div class="text-xs font-mono text-cyan-400 font-bold">☁️ LOOKING FOR TURNKEY MANAGED CLOUD?</div>
          <h3 class="text-lg sm:text-xl font-bold text-white">Discover Aegis Cloud Managed</h3>
          <p class="text-xs text-slate-400 font-sans max-w-xl">
            1-click passive audit, certified Level 2 DNS penetration tests, and managed sovereign hosting on European OVHcloud servers with SecOps support.
          </p>
        </div>
        <a 
          href="https://aegis.aivo.fr" 
          target="_blank" 
          rel="noopener noreferrer"
          class="shrink-0 px-5 py-3 rounded-xl bg-cyan-500/10 hover:bg-cyan-500/20 text-cyan-300 border border-cyan-500/30 font-mono text-xs font-bold transition-colors flex items-center gap-2"
        >
          <span>Visit aegis.aivo.fr</span>
          <span>↗</span>
        </a>
      </div>
    </section>

  </main>
</Layout>
