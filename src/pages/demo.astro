---
import Layout from '../layouts/Layout.astro';
import AegisUnifiedCockpit from '../components/soc/AegisUnifiedCockpit.vue';
---

<Layout 
  title="Aegis Interactive Sandbox • Real-Time Zero-Trust & Replay Showcase (demo.aegis.aivo.fr)"
  description="Public interactive showcase of the Aegis sovereign suite: live Shannon entropy fuzzer, 24h real-world attack replayer, and hardware RAPL energy telemetry."
  isApp={true}
  lang="en"
>
  <main class="flex-1 flex flex-col w-full h-full min-h-0 overflow-hidden">
    <AegisUnifiedCockpit isDemo={true} client:only="vue" />
  </main>
</Layout>
