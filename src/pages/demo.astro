---
import Layout from '../layouts/Layout.astro';
import AegisUnifiedCockpit from '../components/soc/AegisUnifiedCockpit.vue';
---

<Layout 
  title="Aegis Interactive Sandbox • Démonstrateur Zero-Trust & Replay Temps Réel (demo.aegis.aivo.fr)"
  description="Démonstrateur public et interactif de la suite souveraine Aegis : Fuzzer d'entropie de Shannon en direct, replayer de trafic d'attaques réelles sur 24h et télémétrie silicium RAPL."
  isApp={true}
>
  <main class="flex-1 flex flex-col w-full h-full min-h-0 overflow-hidden">
    <AegisUnifiedCockpit isDemo={true} client:only="vue" />
  </main>
</Layout>
