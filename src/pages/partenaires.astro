---
import Layout from '../layouts/Layout.astro';
import AegisLogo from '../components/AegisLogo.astro';
---

<Layout 
  title="Become a Partner • Design Partner Program & Emergency Security Setup | Aegis"
  description="Join the Aegis Design Partner Program or request an Emergency Security Audit & Aegis Setup to protect your infrastructure without software bloat."
  lang="en"
>
  <main class="flex-grow py-16 md:py-24 relative overflow-hidden">
    <!-- Subtle grid and background glow -->
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#10b9810a_1px,transparent_1px),linear-gradient(to_bottom,#10b9810a_1px,transparent_1px)] bg-[size:36px_36px] pointer-events-none"></div>
    <div class="absolute top-16 left-1/2 -translate-x-1/2 w-[650px] h-[300px] bg-gradient-to-tr from-emerald-500/10 via-teal-400/10 to-transparent blur-3xl pointer-events-none rounded-full"></div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 space-y-16">
      
      <!-- 1. PARTNERS PAGE HEADER -->
      <div class="max-w-3xl mx-auto text-center space-y-5">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-slate-900/90 border border-emerald-500/30 text-xs font-mono text-emerald-300">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>PARTNER PROGRAM &amp; EXPERT ENGAGEMENT</span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight leading-[1.15]">
          Secure your infrastructure alongside the <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-teal-300 to-cyan-400">architects of Aegis</span>.
        </h1>

        <p class="text-base sm:text-lg text-slate-300 leading-relaxed">
          Whether you want to co-build the future of frugal cybersecurity through our <strong>Design Partner</strong> program or trigger an urgent hardening engagement (<strong>Emergency Security Audit &amp; Aegis Setup</strong>), our engineers support you across any infrastructure (VPS, Bare-Metal, Kubernetes, Multi-Cloud).
        </p>
      </div>

      <!-- 2. TWO ENGAGEMENT TRACKS -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-stretch">
        
        <!-- TRACK 1: DESIGN PARTNER PROGRAM -->
        <div class="p-8 rounded-3xl bg-slate-900/85 border border-emerald-500/40 backdrop-blur-xl flex flex-col justify-between shadow-2xl relative overflow-hidden">
          <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-emerald-400 to-teal-400"></div>
          <div class="space-y-5">
            <div class="flex items-center justify-between">
              <span class="px-3 py-1 rounded-full text-xs font-mono font-bold bg-emerald-500/15 text-emerald-300 border border-emerald-500/30">
                B2B Co-Engineering &amp; Assisted Beta
              </span>
              <span class="text-xs font-mono text-slate-400">Global • Multi-Cloud / On-Prem</span>
            </div>

            <div>
              <h2 class="text-2xl font-extrabold text-white">Design Partner Program</h2>
              <p class="text-sm text-slate-300 mt-2 leading-relaxed">
                Tailored for SaaS companies, hosting providers, tech scale-ups, and DevSecOps teams looking to deploy Aegis in production with hands-on assistance and directly influence our engineering roadmap.
              </p>
            </div>

            <div class="p-4 rounded-2xl bg-slate-950/80 border border-slate-800 space-y-3 text-xs font-mono text-slate-300">
              <div class="text-emerald-300 font-bold uppercase tracking-wider">Included in the partnership:</div>
              <ul class="space-y-2.5">
                <li class="flex items-start gap-2.5">
                  <span class="text-emerald-400 font-bold">✓</span>
                  <span><strong>End-to-end assisted deployment</strong> on your Linux hosts, Docker stacks, or Kubernetes clusters.</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="text-emerald-400 font-bold">✓</span>
                  <span><strong>Custom calibration</strong> of Ingress WAF (&lt; 1.5 ms) and Egress DNS/TCP Sinkhole on your business flows (zero false positives).</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="text-emerald-400 font-bold">✓</span>
                  <span><strong>Setup of RAPL / Kepler hardware probes</strong> and generation of your first EcoIndex v3 &amp; compliance reports.</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="text-emerald-400 font-bold">✓</span>
                  <span><strong>Direct communication channel</strong> with the core team and prioritized feature development.</span>
                </li>
              </ul>
            </div>
          </div>

          <div class="pt-6 mt-6 border-t border-slate-800">
            <a 
              href="#contact-partenaire" 
              onclick="selectPartnerProgram('DESIGN_PARTNER')"
              class="w-full py-3.5 px-5 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-400 hover:from-emerald-400 hover:to-teal-300 text-slate-950 font-extrabold text-xs font-mono flex items-center justify-center gap-2 transition-all shadow-lg shadow-emerald-500/20"
            >
              <span>Apply to Design Partner Program</span>
              <span>➔</span>
            </a>
          </div>
        </div>

        <!-- TRACK 2: EMERGENCY SECURITY AUDIT & AEGIS SETUP -->
        <div class="p-8 rounded-3xl bg-slate-900/85 border border-cyan-500/40 backdrop-blur-xl flex flex-col justify-between shadow-2xl relative overflow-hidden">
          <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-cyan-400 to-emerald-400"></div>
          <div class="space-y-5">
            <div class="flex items-center justify-between">
              <span class="px-3 py-1 rounded-full text-xs font-mono font-bold bg-cyan-500/15 text-cyan-300 border border-cyan-500/30">
                ⚡ Fast-Track • 48h SLA
              </span>
              <span class="text-xs font-mono text-slate-400">International Response</span>
            </div>

            <div>
              <h2 class="text-2xl font-extrabold text-white">Emergency Security Audit &amp; Aegis Setup</h2>
              <p class="text-sm text-slate-300 mt-2 leading-relaxed">
                A 48-hour emergency engagement to audit exposed attack surfaces, neutralize active intrusion or exfiltration vectors (RCE, PHP2Shell, C2 callbacks), and deploy Aegis shield in front of critical servers.
              </p>
            </div>

            <div class="p-4 rounded-2xl bg-slate-950/80 border border-slate-800 space-y-3 text-xs font-mono text-slate-300">
              <div class="text-cyan-300 font-bold uppercase tracking-wider">Fast-track protocol:</div>
              <ul class="space-y-2.5">
                <li class="flex items-start gap-2.5">
                  <span class="text-cyan-400 font-bold">⚡</span>
                  <span><strong>48h Security &amp; Outbound Egress Audit</strong>: Comprehensive vulnerability analysis (critical CVEs, PHP2Shell, injections, header and secret leaks).</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="text-cyan-400 font-bold">⚡</span>
                  <span><strong>Aegis Gate &amp; Egress Setup on K8s / Cloud</strong>: Transparent inline proxy setup on Scaleway, AWS, Hetzner, OVHcloud, or Bare-Metal.</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="text-cyan-400 font-bold">⚡</span>
                  <span><strong>Custom Outbound Policies &amp; Virtual Patching</strong>: Immediate lockout of illegitimate outbound traffic and automated bot/scanner mitigation without touching app code.</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="text-cyan-400 font-bold">⚡</span>
                  <span><strong>Audit mandate &amp; NDA included</strong>: Executive and technical remediation deliverables delivered upon completion.</span>
                </li>
              </ul>
            </div>
          </div>

          <div class="pt-6 mt-6 border-t border-slate-800">
            <a 
              href="#contact-partenaire" 
              onclick="selectPartnerProgram('EMERGENCY_AUDIT_SETUP')"
              class="w-full py-3.5 px-5 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-extrabold text-xs font-mono flex items-center justify-center gap-2 transition-all shadow-lg shadow-cyan-500/20"
            >
              <span>Request Emergency Audit &amp; Setup</span>
              <span>➔</span>
            </a>
          </div>
        </div>

      </div>

      <!-- 3. CONTACT FORM (CONNECTED TO AIVO CONTROL CENTER API) -->
      <div id="contact-partenaire" class="max-w-3xl mx-auto p-8 sm:p-10 rounded-3xl bg-slate-900/90 border border-slate-800 shadow-2xl backdrop-blur-xl">
        <div class="flex items-center gap-3 mb-6">
          <AegisLogo size="md" />
          <div>
            <h3 class="text-xl font-extrabold text-white">Contact the Aegis Engineering Team</h3>
            <p class="text-xs text-slate-400 font-mono">
              Your request is directly submitted to our Control Center for dispatch within 24 business hours.
            </p>
          </div>
        </div>

        <form id="aivo-partner-form" class="space-y-4 font-mono text-xs" onsubmit="event.preventDefault(); submitPartnerContact();">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-slate-300 mb-1.5 font-semibold">Desired Engagement</label>
              <select id="partner-program" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white focus:border-emerald-400 focus:outline-none">
                <option value="DESIGN_PARTNER">Design Partner Program (Assisted Beta)</option>
                <option value="EMERGENCY_AUDIT_SETUP">Emergency Security Audit &amp; Aegis Setup (48h)</option>
                <option value="GENERAL_PARTNERSHIP">Other Custom Integration / Consultation</option>
              </select>
            </div>
            <div>
              <label class="block text-slate-300 mb-1.5 font-semibold">Target Domain or Scope</label>
              <input type="text" id="partner-domain" required placeholder="my-company.com" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white focus:border-emerald-400 focus:outline-none" />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-slate-300 mb-1.5 font-semibold">Full Name</label>
              <input type="text" id="partner-name" required placeholder="Alex Martin" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white focus:border-emerald-400 focus:outline-none" />
            </div>
            <div>
              <label class="block text-slate-300 mb-1.5 font-semibold">Work Email</label>
              <input type="email" id="partner-email" required placeholder="alex@company.com" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white focus:border-emerald-400 focus:outline-none" />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-slate-300 mb-1.5 font-semibold">Company / Organization</label>
              <input type="text" id="partner-company" placeholder="Acme Corp" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white focus:border-emerald-400 focus:outline-none" />
            </div>
            <div>
              <label class="block text-slate-300 mb-1.5 font-semibold">Current Infrastructure</label>
              <input type="text" id="partner-infra" placeholder="Linux VPS, Kubernetes, AWS, Scaleway..." class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white focus:border-emerald-400 focus:outline-none" />
            </div>
          </div>

          <div>
            <label class="block text-slate-300 mb-1.5 font-semibold">Context &amp; Objectives</label>
            <textarea id="partner-message" rows="3" required placeholder="Briefly describe your architecture and expectations..." class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white focus:border-emerald-400 focus:outline-none"></textarea>
          </div>

          <button type="submit" id="partner-submit-btn" class="w-full py-3.5 px-6 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-400 hover:from-emerald-400 hover:to-teal-300 text-slate-950 font-extrabold text-sm transition-all cursor-pointer shadow-lg shadow-emerald-500/20">
            Submit Support Request ➔
          </button>
        </form>

        <!-- AIVO Control Center Confirmation -->
        <div id="partner-confirm-box" class="hidden mt-5 p-4 rounded-2xl bg-emerald-950/60 border border-emerald-500/40 text-xs font-mono text-emerald-200 space-y-2">
          <div class="font-bold text-emerald-300">✓ Partnership request transmitted to AIVO Control Center</div>
          <p class="text-slate-300 text-[11px]">
            Your request has been structured for our dispatch system. An Aegis architect will follow up shortly.
          </p>
        </div>
      </div>

    </div>
  </main>

  <script is:inline>
    function selectPartnerProgram(val) {
      const sel = document.getElementById('partner-program');
      if (sel) sel.value = val;
    }

    async function submitPartnerContact() {
      const btn = document.getElementById('partner-submit-btn');
      const confirmBox = document.getElementById('partner-confirm-box');
      const payload = {
        schema_version: '1.0',
        product: 'AEGIS_CYBER_GREEN',
        submitted_at_utc: new Date().toISOString(),
        source: 'aegis_partner_page',
        offer_type: document.getElementById('partner-program').value,
        prospect: {
          full_name: document.getElementById('partner-name').value,
          email: document.getElementById('partner-email').value,
          company: document.getElementById('partner-company').value,
          domain: document.getElementById('partner-domain').value,
          infrastructure: document.getElementById('partner-infra').value,
          message: document.getElementById('partner-message').value,
        },
        full_audit_report: null
      };

      window.__lastAivoLeadPayload = payload;
      btn.disabled = true;
      btn.innerText = 'Transmitting to AIVO Control Center...';

      try {
        await fetch('/api/leads', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
      } catch (e) {
        // Local API relay or fallback
      } finally {
        btn.disabled = false;
        btn.innerText = '✓ Request Transmitted';
        confirmBox.classList.remove('hidden');
      }
    }
  </script>
</Layout>
