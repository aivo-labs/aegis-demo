---
import Layout from '../../layouts/Layout.astro';
---

<Layout 
  title="Connexion SSO • Aegis SOC"
  description="Redirection sécurisée vers la mire d'authentification souveraine OIDC / Keycloak."
  isApp={true}
  lang="fr"
>
  <div class="min-h-screen bg-[#090e1a] text-slate-100 flex flex-col items-center justify-center p-4">
    <div class="flex flex-col items-center gap-4 text-center">
      <div class="w-10 h-10 border-4 border-emerald-500 border-t-transparent rounded-full animate-spin"></div>
      <p class="text-sm font-mono text-slate-300">Redirection vers la mire d'authentification souveraine...</p>
    </div>
  </div>
</Layout>

<script is:inline>
  (async function() {
    try {
      const res = await fetch('/api/auth/me', { credentials: 'include' });
      if (res.ok) {
        const data = await res.json();
        if (data && data.authenticated) {
          window.location.replace('/app/');
          return;
        }
      }
    } catch (e) {}

    // Redirection directe vers la mire Keycloak via Pure BFF
    window.location.replace('/api/auth/login');
  })();
</script>
