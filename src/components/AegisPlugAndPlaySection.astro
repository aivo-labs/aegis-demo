---
// AegisPlugAndPlaySection.astro — Présente Aegis comme une surcouche Plug & Play légère
import { useTranslations, type Locale } from '../i18n/translations';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang).plugAndPlay;
---

<section class="relative py-20 md:py-28 border-b border-slate-800/80 bg-[#0a0f1d]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
    
    <div class="max-w-3xl mx-auto text-center space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-900 border border-slate-700 text-xs font-mono text-teal-300">
        <span>{t.badge}</span>
      </div>
      <h2 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight" set:html={t.title} />
      <p class="text-sm sm:text-base text-slate-300 leading-relaxed" set:html={t.desc} />
    </div>

    <!-- Comparatif / Synergie Plug & Play en 3 colonnes -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      
      <!-- Carte 1 : Synergie avec CrowdSec & Pare-feux -->
      <div class="p-6 rounded-3xl bg-slate-900/70 border border-slate-800 hover:border-emerald-500/40 transition-all space-y-3">
        <div class="w-10 h-10 rounded-xl bg-emerald-500/15 border border-emerald-500/30 flex items-center justify-center text-emerald-400 font-mono font-bold">
          🤝
        </div>
        <h3 class="text-lg font-bold text-white">{t.card1Title}</h3>
        <p class="text-xs sm:text-sm text-slate-300 leading-relaxed" set:html={t.card1Desc} />
      </div>

      <!-- Carte 2 : Zéro Alourdissement du SI -->
      <div class="p-6 rounded-3xl bg-slate-900/70 border border-slate-800 hover:border-teal-500/40 transition-all space-y-3">
        <div class="w-10 h-10 rounded-xl bg-teal-500/15 border border-teal-500/30 flex items-center justify-center text-teal-400 font-mono font-bold">
          🪶
        </div>
        <h3 class="text-lg font-bold text-white">{t.card2Title}</h3>
        <p class="text-xs sm:text-sm text-slate-300 leading-relaxed" set:html={t.card2Desc} />
      </div>

      <!-- Carte 3 : Déploiement & Rollback Instantanés -->
      <div class="p-6 rounded-3xl bg-slate-900/70 border border-slate-800 hover:border-cyan-500/40 transition-all space-y-3">
        <div class="w-10 h-10 rounded-xl bg-cyan-500/15 border border-cyan-500/30 flex items-center justify-center text-cyan-400 font-mono font-bold">
          ⚡
        </div>
        <h3 class="text-lg font-bold text-white">{t.card3Title}</h3>
        <p class="text-xs sm:text-sm text-slate-300 leading-relaxed" set:html={t.card3Desc} />
      </div>

    </div>

    <!-- Bandeau Schéma d'insertion -->
    <div class="p-5 rounded-2xl bg-slate-950/90 border border-slate-800/90 flex flex-col md:flex-row items-center justify-between gap-4 font-mono text-xs">
      <div class="text-slate-400">
        <span class="text-emerald-400 font-bold">{t.insertionLabel}</span> {t.insertionDesc}
      </div>
      <div class="flex flex-wrap items-center gap-2 text-[11px]">
        <span class="px-2.5 py-1 rounded-lg bg-slate-900 border border-slate-700 text-slate-300">{t.stepInternet}</span>
        <span class="text-emerald-400">➔</span>
        <span class="px-2.5 py-1 rounded-lg bg-slate-900 border border-slate-700 text-slate-300">{t.stepCrowdsec}</span>
        <span class="text-emerald-400">➔</span>
        <span class="px-3 py-1 rounded-lg bg-emerald-500/20 border border-emerald-500/40 text-emerald-300 font-bold">{t.stepAegis}</span>
        <span class="text-emerald-400">➔</span>
        <span class="px-2.5 py-1 rounded-lg bg-slate-900 border border-slate-700 text-white">{t.stepApp}</span>
      </div>
    </div>

  </div>
</section>
